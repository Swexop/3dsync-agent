# Derlenmis binary (build.sh / CI tarafindan uretilir, kaynak degil)
/3dsync-agent
/3dsync-agent-*

# go test gecici dosyalari
*.test
*.out

# Lisanslama: private key ve uretilmis lisans dosyalari -- BUNLAR ASLA
# bu repoya girmemeli (private key SIR, license.lic musteriye OZEL).
# license-gen aracinin kendisi (kaynak kodu) commit'lenir, SADECE
# urettigi dosyalar/anahtarlar burada halicleniyor.
*.lic
*license-private.key
/cmd/license-gen/license-gen

# Musteriye ozel kurulum dosyalari: secrets.sh her zaman gizli parola/
# kimlik bilgisi icerir -- repoya ASLA girmemeli (env.sh gizli degildir,
# o yuzden burada degil).
customers/*/secrets.sh
